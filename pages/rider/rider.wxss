/* pages/rider/rider.wxss - 骑手中心（iOS 18 磨砂玻璃风格） */
.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 未开通：hero */
.hero-card {
  background: linear-gradient(135deg, rgba(0, 122, 255, 0.14), rgba(0, 122, 255, 0.04));
  margin: 0 32rpx;
}

.hero-row {
  display: flex;
  align-items: center;
  padding: 40rpx 28rpx;
}

.hero-row icon {
  margin-right: 24rpx;
  flex-shrink: 0;
}

.hero-info {
  display: flex;
  flex-direction: column;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.hero-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

/* 收益规则 */
.rule-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
}

.rule-key {
  font-size: 30rpx;
  color: var(--text-primary);
}

.rule-val {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: right;
}

/* 微信登录 */
.wx-login-row {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
}

.wx-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  padding: 0;
  margin: 0;
  background: rgba(120, 120, 128, 0.12);
  flex-shrink: 0;
  border: none;
  line-height: normal;
}

.wx-avatar::after { border: none; border-radius: 50%; }

.wx-avatar-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: block;
}

.wx-nickname {
  flex: 1;
  margin-left: 24rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
}

/* 表单 */
.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  min-height: 56rpx;
}

.form-label {
  font-size: 32rpx;
  color: var(--text-primary);
  width: 160rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 32rpx;
  color: var(--text-primary);
}

.submit-wrap {
  padding: 32rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  font-size: 34rpx;
}

/* 收益概览 */
.balance-section {
  margin: 24rpx 32rpx;
  padding: 36rpx 32rpx;
  border-radius: 24rpx;
  text-align: center;
}

.balance-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.balance-value {
  display: block;
  font-size: 72rpx;
  font-weight: 700;
  margin-top: 8rpx;
  color: var(--text-primary);
  letter-spacing: -1rpx;
}

.balance-sub {
  display: flex;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--separator-opaque);
}

.sub-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sub-num {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.sub-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

.sub-divider {
  width: 1rpx;
  align-self: stretch;
  margin: 8rpx 0;
  background: var(--separator-opaque);
}

.withdraw-btn {
  margin-top: 28rpx;
  width: 100%;
  height: 88rpx;
  font-size: 32rpx;
}

.withdraw-btn.disabled {
  opacity: 0.5;
}

/* 分段控制 */
.segment {
  display: flex;
  border-radius: 100rpx;
  margin: 8rpx 32rpx 0;
  padding: 6rpx;
}

.segment-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
  border-radius: 100rpx;
  transition: all 0.2s ease;
  font-weight: 500;
}

.segment-item.active {
  background: #FFFFFF;
  color: var(--text-primary);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

/* 订单卡 */
.order-list {
  padding: 16rpx 0 20rpx;
}

.rider-order {
  margin: 16rpx 32rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
}

.ro-header {
  display: flex;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--separator-opaque);
}

.ro-header-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.ro-header-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.ro-size {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.ro-loc {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-left: 12rpx;
}

.ro-income {
  font-size: 26rpx;
  font-weight: 600;
  color: #34C759;
}

.ro-accept {
  width: 120rpx !important;
  height: 56rpx !important;
  line-height: 56rpx !important;
  font-size: 26rpx !important;
  font-weight: 600;
  padding: 0 !important;
  display: flex !important;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
}

.ro-body {
  padding: 16rpx 0;
}

.ro-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 0;
  font-size: 26rpx;
  color: var(--text-primary);
}

.ro-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid var(--separator-opaque);
  padding-top: 16rpx;
}

.ro-time {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.ro-actions {
  display: flex;
}

.ro-btn {
  margin-left: 12rpx;
  width: 160rpx !important;
  height: 60rpx !important;
  line-height: 60rpx !important;
  font-size: 26rpx !important;
  padding: 0 !important;
  display: flex !important;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty icon {
  margin-bottom: 16rpx;
  opacity: 0.5;
}

.empty-text {
  color: var(--text-secondary);
  font-size: 28rpx;
}

/* 提现记录 */
.wd-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}

.wd-left {
  display: flex;
  flex-direction: column;
}

.wd-amount {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.wd-time {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
}

.wd-status {
  font-size: 24rpx;
  font-weight: 600;
}

.wd-pending { color: #FF9500; }
.wd-completed { color: #34C759; }
.wd-rejected { color: var(--text-secondary); }

/* 提现弹窗 - bottom-sheet */
.withdraw-sheet {
  padding: 16rpx 32rpx 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.modal-grip {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(60, 60, 67, 0.3);
  margin: 12rpx auto 24rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  color: var(--text-primary);
}

.modal-balance {
  text-align: center;
  color: var(--text-secondary);
  font-size: 26rpx;
  margin: 16rpx 0 24rpx;
}

.wd-input-wrap {
  display: flex;
  align-items: center;
  background: rgba(120, 120, 128, 0.08);
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 0 0 28rpx;
}

.wd-input-wrap .form-label {
  margin: 0;
  margin-right: 16rpx;
  width: auto;
}

.wd-input {
  margin-left: 0;
  text-align: left;
  font-size: 40rpx;
  font-weight: 600;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn::after { border: none; }

.modal-confirm[disabled] {
  opacity: 0.5;
}
