<!-- pages/admin/dashboard.wxml - 管理员后台（iOS 18 磨砂玻璃风格） -->
<view class="page">
  <!-- 磨砂返回栏 -->
  <view class="glass-nav nav-bar">
    <view class="nav-back" bindtap="goBack">
      <view class="nav-back-chevron"></view>
      <text>返回</text>
    </view>
    <text class="nav-title">管理员后台</text>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 统计 -->
  <view class="section-header">数据概览</view>
  <view class="stat-row">
    <view class="glass-card stat-item">
      <text class="stat-num">{{totalCount}}</text>
      <text class="stat-label">总订单</text>
    </view>
    <view class="glass-card stat-item">
      <text class="stat-num">¥{{totalAmount}}</text>
      <text class="stat-label">总金额</text>
    </view>
  </view>

  <!-- 说明 -->
  <view class="section-header">说明</view>
  <view class="glass-card note-card">
    <view class="note-row">正常流程无需管理员操作，此页面仅用于事后抽查。请定期核对微信/支付宝账单。</view>
  </view>

  <!-- 提现审核入口 -->
  <view class="section-header">审核</view>
  <view class="glass-list">
    <view class="glass-list-item menu-item" bindtap="openWithdrawReview">
      <icon name="wallet" size="36" color="#007AFF" />
      <text class="menu-title">骑手提现审核</text>
      <icon name="chevron-right" size="28" color="var(--text-tertiary)" />
    </view>
  </view>

  <!-- 状态筛选 -->
  <view class="glass-nav tabs-bar">
    <scroll-view class="tabs-scroll" scroll-x="true" show-scrollbar="{{false}}">
      <view class="tabs">
        <view class="tab {{activeTab === 'all' ? 'active' : ''}}" bindtap="switchTab" data-tab="all">全部</view>
        <view class="tab {{activeTab === 'pending_payment' ? 'active' : ''}}" bindtap="switchTab" data-tab="pending_payment">待付款</view>
        <view class="tab {{activeTab === 'accepted' ? 'active' : ''}}" bindtap="switchTab" data-tab="accepted">已接单</view>
        <view class="tab {{activeTab === 'delivering' ? 'active' : ''}}" bindtap="switchTab" data-tab="delivering">配送中</view>
        <view class="tab {{activeTab === 'completed' ? 'active' : ''}}" bindtap="switchTab" data-tab="completed">已完成</view>
        <view class="tab {{activeTab === 'cancelled' ? 'active' : ''}}" bindtap="switchTab" data-tab="cancelled">已取消</view>
      </view>
    </scroll-view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list" wx:if="{{orders.length > 0}}">
    <view class="glass-card admin-order" wx:for="{{orders}}" wx:key="_id">
      <view class="admin-header">
        <text class="admin-no" selectable>{{item._id}}</text>
        <text class="tag tag-{{item.status}}">{{statusTextMap[item.status]}}</text>
      </view>
      <view class="admin-grid">
        <view class="admin-field">
          <text class="admin-label">用户</text>
          <text class="admin-value">{{item.userNickname || '匿名'}}</text>
        </view>
        <view class="admin-field">
          <text class="admin-label">收货人</text>
          <text class="admin-value">{{item.recipientName}}</text>
        </view>
        <view class="admin-field">
          <text class="admin-label">取件码</text>
          <text class="admin-value">{{item.pickupCode}}</text>
        </view>
        <view class="admin-field" wx:if="{{item.deliveryZone}}">
          <text class="admin-label">园区</text>
          <text class="admin-value">{{item.deliveryZone}}</text>
        </view>
        <view class="admin-field">
          <text class="admin-label">包裹</text>
          <text class="admin-value">{{item.packageSize === 'small' ? '小件' : item.packageSize === 'medium' ? '中件' : '大件'}} / {{item.locationType === 'offCampus' ? '校外' : '校内'}}</text>
        </view>
        <view class="admin-field">
          <text class="admin-label">金额</text>
          <text class="admin-value price">¥{{item.price}}</text>
        </view>
        <view class="admin-field">
          <text class="admin-label">付款时间</text>
          <text class="admin-value">{{item.payTimeText || '--'}}</text>
        </view>
      </view>
      <view class="admin-remark" wx:if="{{item.remark}}">
        <text class="admin-label">备注：</text>
        <text>{{item.remark}}</text>
      </view>
      <view class="admin-actions">
        <button class="btn-outline action-contact" open-type="contact" size="mini" session-from="管理员查看订单:{{item._id}},类型:{{item.orderType}},用户:{{item.userNickname || '匿名'}},openid:{{item.userId || ''}}">联系用户</button>
        <button class="btn-warning action-unpaid" bindtap="markUnpaid" data-id="{{item._id}}" data-price="{{item.price}}" data-user="{{item.userNickname}}" size="mini">标记未付款</button>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{orders.length === 0 && !loading}}">
    <icon name="checkmark" size="80" color="var(--text-tertiary)" />
    <text class="empty-text">暂无可抽查订单</text>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore && orders.length > 0}}">
    <text wx:if="{{loading}}">加载中...</text>
    <text wx:else bindtap="loadMore">点击加载更多</text>
  </view>

  <!-- 标记未付款确认弹窗 -->
  <view class="glass-mask" wx:if="{{showUnpaidModal}}" catchtap="closeUnpaidModal"></view>
  <view class="center-modal confirm-modal" wx:if="{{showUnpaidModal}}">
    <view class="confirm-header">确认操作</view>
    <view class="confirm-body">
      <text class="confirm-text">确定将订单 <text class="confirm-highlight">{{markingOrderId}}</text> 标记为未付款吗？</text>
      <text class="confirm-text sub">用户将被通知重新付款</text>
      <label class="blacklist-label">
        <checkbox checked="{{blacklistUser}}" bindtap="toggleBlacklist" />
        <text>同时拉黑该用户（禁止再次下单）</text>
      </label>
    </view>
    <view class="confirm-btns">
      <button class="btn-ghost confirm-btn confirm-cancel" bindtap="closeUnpaidModal">取消</button>
      <button class="btn-warning confirm-btn confirm-danger" bindtap="confirmMarkUnpaid">确认标记</button>
    </view>
  </view>

  <!-- 提现审核弹窗 -->
  <view class="glass-mask" wx:if="{{showWithdrawModal}}" catchtap="closeWithdrawReview"></view>
  <view class="bottom-sheet withdraw-modal" wx:if="{{showWithdrawModal}}">
    <view class="modal-grip"></view>
    <view class="withdraw-header">骑手提现审核</view>
    <scroll-view class="withdraw-list" scroll-y="true">
      <view class="withdraw-empty" wx:if="{{withdrawList.length === 0}}">
        <text>暂无提现申请</text>
      </view>
      <view class="glass-card withdraw-card" wx:for="{{withdrawList}}" wx:key="_id">
        <view class="withdraw-top">
          <text class="withdraw-amount">{{item.amountText}}</text>
          <text class="withdraw-status wd-{{item.status}}">{{item.statusText}}</text>
        </view>
        <view class="withdraw-info">
          <text>骑手：{{item.riderName || '匿名'}}（{{item.riderPhone || '无'}}）</text>
          <text>申请时间：{{item.createTimeText}}</text>
        </view>
        <view class="withdraw-actions" wx:if="{{item.canHandle}}">
          <button class="btn-outline wd-action wd-reject" size="mini" bindtap="handleWithdraw" data-id="{{item._id}}" data-action="reject">驳回</button>
          <button class="btn-primary wd-action wd-approve" size="mini" bindtap="handleWithdraw" data-id="{{item._id}}" data-action="approve">通过</button>
        </view>
      </view>
    </scroll-view>
    <button class="btn-ghost withdraw-close" bindtap="closeWithdrawReview">关闭</button>
  </view>
</view>
