.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.brand-section {
  padding: 72rpx 32rpx 32rpx;
}

.brand-card {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 36rpx;
  background: linear-gradient(135deg, #F5F9FF 0%, #F0F5FF 100%);
  border: 1rpx solid rgba(0, 122, 255, 0.12);
  border-radius: 32rpx;
  padding: 88rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 122, 255, 0.08);
}

.brand-logo {
  width: 152rpx;
  height: 152rpx;
  flex-shrink: 0;
  border-radius: 32rpx;
}

.brand-info {
  display: flex;
  flex-direction: column;
}

.brand-title {
  font-size: 60rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -1rpx;
  line-height: 1.25;
}

.brand-subtitle {
  font-size: 34rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
}

.service-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  padding: 0 32rpx;
}

.service-card {
  border-radius: 32rpx;
  padding: 32rpx;
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: transform 0.1s ease;
}

.service-card:active {
  transform: scale(0.97);
}

.card-blue {
  background: linear-gradient(135deg, #F0F7FF 0%, #E6F1FF 100%);
  border: 1rpx solid rgba(0, 122, 255, 0.12);
}

.card-orange {
  background: linear-gradient(135deg, #FFF9ED 0%, #FFF3DB 100%);
  border: 1rpx solid rgba(255, 149, 0, 0.18);
}

.card-green {
  background: linear-gradient(135deg, #F0FDF4 0%, #E3F9E9 100%);
  border: 1rpx solid rgba(52, 199, 89, 0.14);
}

.card-purple {
  background: linear-gradient(135deg, #F8F5FF 0%, #F2EDFF 100%);
  border: 1rpx solid rgba(175, 82, 222, 0.12);
}

.service-icon {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.service-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.service-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.dock-placeholder {
  height: 140rpx;
}
