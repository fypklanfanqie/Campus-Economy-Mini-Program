/* pages/print/print.wxss - 文件打印下单页样式（iOS 18 磨砂玻璃风格） */
.page {
  padding-bottom: 60rpx;
  min-height: 100vh;
}

/* 上传区 - 磨砂虚线卡片 */
.upload-card {
  margin: 0 32rpx;
  padding: 56rpx 24rpx;
  text-align: center;
  border: 2rpx dashed rgba(0, 122, 255, 0.4);
  transition: background 0.15s ease;
}

.upload-card:active {
  background: rgba(0, 122, 255, 0.04);
}

.upload-plus {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.upload-tip {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-top: 18rpx;
  font-weight: 500;
}

.upload-sub {
  font-size: 24rpx;
  color: #007AFF;
  margin-top: 8rpx;
  font-weight: 600;
}

.upload-hint {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 14rpx;
  line-height: 1.5;
}

/* 已选文件 */
.file-box {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: transparent;
}

.file-icon {
  margin-right: 20rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.file-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.file-name {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.file-size {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

.file-rechoose {
  font-size: 26rpx;
  color: #007AFF;
  font-weight: 500;
  padding: 8rpx 20rpx;
  background: rgba(0, 122, 255, 0.1);
  border-radius: 100rpx;
}

/* 解析 */
.parse-row {
  padding: 20rpx 28rpx 0;
}

.parse-btn {
  width: 100%;
  height: 84rpx;
  font-size: 30rpx;
}

.parse-tip {
  padding: 16rpx 28rpx 0;
  font-size: 24rpx;
  color: #FF9500;
  text-align: center;
}

/* 手动页数 */
.manual-row {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  background: rgba(120, 120, 128, 0.06);
  margin: 20rpx 28rpx 24rpx;
  border-radius: 16rpx;
}

.manual-label {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.manual-input {
  flex: 1;
  text-align: right;
  font-size: 32rpx;
  color: #007AFF;
  font-weight: 600;
}

.manual-unit {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-left: 12rpx;
}

/* 明细 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  background: transparent;
}

.info-label {
  font-size: 30rpx;
  color: var(--text-primary);
}

.info-value {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.price-row {
  padding-top: 28rpx;
}

/* 步进器 */
.stepper {
  display: flex;
  align-items: center;
  background: rgba(120, 120, 128, 0.12);
  border-radius: 100rpx;
  overflow: hidden;
}

.step-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s ease;
}

.step-btn:active {
  background: rgba(0, 122, 255, 0.12);
}

.step-num {
  width: 72rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* 表单 */
.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  min-height: 56rpx;
  background: transparent;
}

.form-item-textarea {
  flex-direction: column;
  align-items: flex-start;
}

.form-label {
  width: 150rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
  text-align: right;
}

.picker-value {
  flex: 1;
  font-size: 30rpx;
  text-align: right;
  margin-right: 8rpx;
}

.picker-value.placeholder {
  color: var(--text-tertiary);
}

.form-textarea {
  width: 100%;
  font-size: 28rpx;
  color: var(--text-primary);
  min-height: 80rpx;
  margin-top: 16rpx;
}

/* 提交 */
.submit-wrap {
  padding: 32rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  font-size: 34rpx;
}

/* 园区选择器 */
.zone-modal {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.modal-grip {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(60, 60, 67, 0.3);
  margin: 12rpx auto 20rpx;
}

.zone-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.zone-list {
  max-height: 560rpx;
}

.zone-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  font-size: 32rpx;
  color: var(--text-primary);
  border-bottom: 1rpx solid var(--separator-opaque);
  border-radius: 16rpx;
  transition: background 0.15s ease;
}

.zone-item:active {
  background: rgba(0, 0, 0, 0.04);
}

.zone-item.selected {
  color: #007AFF;
  font-weight: 600;
  background: rgba(0, 122, 255, 0.04);
}

.zone-confirm {
  width: 100%;
  height: 92rpx;
  margin-top: 24rpx;
  font-size: 32rpx;
}

/* 收款弹窗 */
.payment-modal {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border-radius: 32rpx;
  z-index: 1001;
  padding: 40rpx 36rpx;
}

.modal-title {
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.modal-desc {
  text-align: center;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
}

.highlight {
  color: #FF3B30;
  font-weight: 600;
}

.order-no-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 24rpx 0;
  padding: 20rpx;
  background: rgba(120, 120, 128, 0.08);
  border-radius: 16rpx;
}

.order-no-label {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.order-no-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  word-break: break-all;
}

.qrcode-tabs {
  display: flex;
  background: rgba(120, 120, 128, 0.12);
  border-radius: 16rpx;
  padding: 6rpx;
  margin: 16rpx 0;
}

.qrcode-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
  border-radius: 12rpx;
}

.qrcode-tab.active {
  background: #FFFFFF;
  color: #007AFF;
  font-weight: 600;
}

.qrcode-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 20rpx 0;
}

.qrcode-image {
  width: 360rpx;
  height: 360rpx;
  background: rgba(120, 120, 128, 0.08);
  border-radius: 16rpx;
}

.qrcode-tip {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
}

.amount-reminder {
  text-align: center;
  font-size: 28rpx;
  margin: 16rpx 0;
}

.remark-reminder {
  text-align: center;
  font-size: 24rpx;
  color: #FF9500;
  margin-bottom: 20rpx;
}

.confirm-btn {
  width: 100%;
  height: 92rpx;
  font-size: 32rpx;
}

.modal-close {
  text-align: center;
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-top: 20rpx;
}
