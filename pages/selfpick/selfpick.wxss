/* pages/selfpick/selfpick.wxss - 校内商家代取餐（iOS 18 磨砂玻璃风格） */
.page {
  padding-bottom: 60rpx;
  min-height: 100vh;
}

/* 说明 - 蓝色渐变提示卡片 */
.intro-card {
  display: flex;
  align-items: center;
  margin: 0 32rpx;
  padding: 32rpx 28rpx;
  background: linear-gradient(135deg, #007AFF, #0A84FF);
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(0, 122, 255, 0.25);
}

.intro-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.intro-body {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.intro-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.intro-price {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 600;
  margin-top: 12rpx;
}

/* 注意事项 */
.note-row {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: transparent;
}

.note-icon {
  width: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.note-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 表单 */
.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  min-height: 56rpx;
  background: transparent;
}

.form-label {
  width: 160rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  text-align: right;
  color: var(--text-primary);
}

.picker-value {
  flex: 1;
  font-size: 30rpx;
  text-align: right;
  color: var(--text-primary);
  margin-right: 8rpx;
}

.picker-value.placeholder {
  color: var(--text-tertiary);
}

/* 已出餐确认 - iOS 蓝色风格 */
.confirm-card {
  display: flex;
  align-items: center;
  margin: 24rpx 32rpx;
  padding: 28rpx;
  background: var(--bg-glass);
  backdrop-filter: saturate(180%) blur(40rpx);
  -webkit-backdrop-filter: saturate(180%) blur(40rpx);
  border: 2rpx solid rgba(120, 120, 128, 0.16);
  border-radius: 24rpx;
  transition: all 0.2s ease;
}

.confirm-card.active {
  border-color: #007AFF;
  background: rgba(0, 122, 255, 0.04);
}

.confirm-box {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  border: 3rpx solid var(--text-tertiary);
  margin-right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.confirm-box.checked {
  background: #007AFF;
  border-color: #007AFF;
}

.confirm-text {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.confirm-main {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.confirm-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

/* 提交 */
.submit-wrap {
  padding: 32rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  font-size: 34rpx;
}

/* 园区选择器 */
.zone-modal {
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.modal-grip {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(60, 60, 67, 0.3);
  margin: 12rpx auto 24rpx;
}

.zone-modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.zone-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.zone-modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.zone-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.zone-cell {
  width: calc((100% - 40rpx) / 3);
  text-align: center;
  padding: 28rpx 0;
  background: rgba(120, 120, 128, 0.1);
  border-radius: 20rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
  box-sizing: border-box;
}

.zone-cell.selected {
  background: rgba(0, 122, 255, 0.06);
  border-color: #007AFF;
  color: #007AFF;
  font-weight: 600;
}
