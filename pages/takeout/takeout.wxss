/* pages/takeout/takeout.wxss - 校门口外卖代拿下单页样式（iOS 18 磨砂玻璃风格） */
.page {
  padding-bottom: 60rpx;
  min-height: 100vh;
}

/* 校门选择 */
.gate-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 24rpx 28rpx;
  background: transparent;
}

.gate-item {
  width: calc((100% - 48rpx) / 4);
  box-sizing: border-box;
  text-align: center;
  padding: 24rpx 0;
  background: rgba(120, 120, 128, 0.1);
  border-radius: 100rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
  font-weight: 500;
}

.gate-item.selected {
  border-color: #007AFF;
  background: rgba(0, 122, 255, 0.06);
  color: #007AFF;
  font-weight: 600;
}

/* 送达方式 */
.delivery-row {
  display: flex;
  align-items: center;
  padding: 28rpx;
  background: transparent;
  transition: background 0.15s ease;
}

.delivery-row:active {
  background: rgba(0, 0, 0, 0.04);
}

.delivery-row.selected {
  background: rgba(0, 122, 255, 0.04);
}

.delivery-icon {
  margin-right: 24rpx;
  width: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.delivery-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.delivery-name {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.delivery-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.delivery-price {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.delivery-row.selected .delivery-price {
  color: #007AFF;
}

/* 明细 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  background: transparent;
}

.info-label {
  font-size: 30rpx;
  color: var(--text-primary);
}

.info-value {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.price-row {
  padding-top: 28rpx;
}

/* 表单 */
.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  min-height: 56rpx;
  background: transparent;
}

.form-item-textarea {
  flex-direction: column;
  align-items: flex-start;
}

.form-label {
  width: 150rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
  text-align: right;
}

.picker-value {
  flex: 1;
  font-size: 30rpx;
  text-align: right;
  margin-right: 8rpx;
}

.picker-value.placeholder {
  color: var(--text-tertiary);
}

.form-textarea {
  width: 100%;
  font-size: 28rpx;
  color: var(--text-primary);
  min-height: 80rpx;
  margin-top: 16rpx;
}

/* 提交 */
.submit-wrap {
  padding: 32rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  font-size: 34rpx;
}

/* 园区选择器 */
.zone-modal {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.modal-grip {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(60, 60, 67, 0.3);
  margin: 12rpx auto 20rpx;
}

.zone-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.zone-list {
  max-height: 560rpx;
}

.zone-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  font-size: 32rpx;
  color: var(--text-primary);
  border-bottom: 1rpx solid var(--separator-opaque);
  border-radius: 16rpx;
  transition: background 0.15s ease;
}

.zone-item:active {
  background: rgba(0, 0, 0, 0.04);
}

.zone-item.selected {
  color: #007AFF;
  font-weight: 600;
  background: rgba(0, 122, 255, 0.04);
}

.zone-confirm {
  width: 100%;
  height: 92rpx;
  margin-top: 24rpx;
  font-size: 32rpx;
}

/* 收款弹窗 */
.payment-modal {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border-radius: 32rpx;
  z-index: 1001;
  padding: 40rpx 36rpx;
}

.modal-title {
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.modal-desc {
  text-align: center;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
}

.highlight {
  color: #FF3B30;
  font-weight: 600;
}

.order-no-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 24rpx 0;
  padding: 20rpx;
  background: rgba(120, 120, 128, 0.08);
  border-radius: 16rpx;
}

.order-no-label {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.order-no-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  word-break: break-all;
}

.qrcode-tabs {
  display: flex;
  background: rgba(120, 120, 128, 0.12);
  border-radius: 16rpx;
  padding: 6rpx;
  margin: 16rpx 0;
}

.qrcode-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
  border-radius: 12rpx;
}

.qrcode-tab.active {
  background: #FFFFFF;
  color: #007AFF;
  font-weight: 600;
}

.qrcode-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 20rpx 0;
}

.qrcode-image {
  width: 360rpx;
  height: 360rpx;
  background: rgba(120, 120, 128, 0.08);
  border-radius: 16rpx;
}

.qrcode-tip {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
}

.amount-reminder {
  text-align: center;
  font-size: 28rpx;
  margin: 16rpx 0;
}

.remark-reminder {
  text-align: center;
  font-size: 24rpx;
  color: #FF9500;
  margin-bottom: 20rpx;
}

.confirm-btn {
  width: 100%;
  height: 92rpx;
  font-size: 32rpx;
}

.modal-close {
  text-align: center;
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-top: 20rpx;
}
